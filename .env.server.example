# Shogun Server mode configuration.
# Copy to .env.server and replace every change-me value before starting.

SHOGUN_BIND_ADDRESS=127.0.0.1
SHOGUN_PORT=8000

POSTGRES_DB=shogun
POSTGRES_USER=shogun
POSTGRES_PASSWORD=change-me-postgres-password

SECRET_KEY=change-me-to-a-random-64-char-string
VAULT_ENCRYPTION_KEY=change-me-to-an-independent-random-64-char-string
SHOGUN_INFRASTRUCTURE_ADMIN_TOKEN=change-me-to-an-independent-infrastructure-admin-token
A2A_ENCRYPTION_KEY=change-me-to-an-independent-a2a-encryption-key
A2A_PUBLIC_URL=
TRUSTED_PROXIES=

# Kiroku MemoryGraph rollout: off | manual | dual
MEMORY_GRAPH_WRITE_MODE=off
MEMORY_GRAPH_RETRIEVAL_MODE=off

# Optional installation telemetry; fail-closed unless notice 1.0 is explicitly accepted.
SHOGUN_TELEMETRY=off
SHOGUN_TELEMETRY_NOTICE_VERSION=
SHOGUN_DISTRIBUTION_CHANNEL=official_docker

# Outbound federation policy. Metadata and link-local addresses are always blocked.
A2A_DESTINATION_POLICY=private_allowed
OUTBOUND_ALLOWLIST=
ALLOW_HTTP_ON_PRIVATE_NETWORK=true
ALLOW_HTTP_ON_PUBLIC_NETWORK=false
A2A_ALLOWED_PORTS=

# Optional communication channels. They can also be configured in The Tenshu.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TEAMS_ADAPTER_ENABLED=false
TEAMS_DEPLOYMENT_MODE=bridge
TEAMS_TENANT_MODE=single
TEAMS_ALLOWED_TENANT_IDS=
TEAMS_BOT_APP_ID=
TEAMS_BOT_CLIENT_SECRET_REF=
TEAMS_PUBLIC_MESSAGING_ENDPOINT=
