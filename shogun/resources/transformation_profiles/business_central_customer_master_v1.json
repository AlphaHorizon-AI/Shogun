      "required": true
    },
    {
      "source": "number",
      "target": "customer_number",
      "type": "string",
      "required": true,
      "transforms": [
        "trim"
      ]
    },
    {
      "source": "displayName",
      "target": "name",
      "type": "string",
      "required": true,
      "transforms": [
        "trim"
      ]
    },
    {
      "source": "type",
      "target": "customer_type",
      "type": "string",
      "required": false
    },
    {
      "source": "addressLine1",
      "target": "address_line_1",
      "type": "string",
      "required": false
    },
    {
      "source": "city",
      "target": "city",
      "type": "string",
      "required": false
    },
    {
      "source": "country",
      "target": "country_code",
      "type": "string",
      "required": false,
      "transforms": [
        "trim",
        "uppercase"
      ]
    },
    {
      "source": "email",
      "target": "email",
      "type": "string",
      "required": false,
      "transforms": [
        "trim",
        "lowercase"
      ]
    },
    {
      "source": "phoneNumber",
      "target": "phone",
      "type": "string",
      "required": false
    },
    {
      "source": "currencyCode",
      "target": "currency_code",
      "type": "string",
      "required": false,
      "transforms": [
        "trim",
        "uppercase"
      ]
    },
    {
      "source": "paymentTermsId",
      "target": "payment_terms_id",
      "type": "string",
      "required": false
    }
  ],
  "invariants": [
    {
      "id": "identity_complete",
      "rule": "required_nonempty",
      "fields": [
        "customer_id"
      ]
    }
  ],
  "privacy": {
    "classification": "confidential",
    "pii_fields": [
      "name",
      "address_line_1",
      "city",
      "email",
      "phone"
    ],
    "secret_fields": [],
    "retention": "inherit_flow_policy"
  },
  "adapter_requirements": {
    "adapter": "canonical_entity_map_v1",
    "minimum_version": 1,
    "status": "available",
    "capabilities": [
      "field_mapping",
      "type_conversion",
      "deduplication",
      "canonical_envelope",
      "lineage",
      "invariant_validation",
      "formula_neutralization"
    ],
    "fail_closed": true
  },
  "selection": {
    "positive_fingerprints": [
      "object:customers",
      "transport:rest",
      "field:id"
    ],
    "negative_fingerprints": []
  },
  "governance": {
    "owner": "enterprise_transformation_skill",
    "promotion": "skillopt_validated",
    "minimum_positive_fixtures": 3,
    "minimum_negative_fixtures": 2,
    "breaking_change_policy": "new_profile_version"
  }
