{
  "resource_type": "transformation_profile",
  "manifest_version": "1.0",
  "id": "business_central_customer_master_v1",
  "version": 1,
  "lifecycle": "candidate",
  "title": "Business Central customer master",
  "description": "Normalize Business Central customer master records into a versioned Shogun canonical contract.",
  "profile_kind": "canonical_ingress",
  "adapter": "canonical_entity_map_v1",
  "parameters": {},
  "platform": {
    "vendor": "Microsoft",
    "product": "Dynamics 365 Business Central",
    "family": "erp"
  },
  "source": {
