      "target": "organization_number",
      "type": "string",
      "required": true
    },
    {
      "source": "organizationName",
      "target": "name",
      "type": "string",
      "required": true
    },
    {
      "source": "organizationType",
      "target": "organization_type",
      "type": "string",
      "required": true
    },
    {
      "source": "superiorOrganization.id",
      "target": "parent_organization_id",
      "type": "string",
      "required": false
    },
    {
      "source": "manager.id",
      "target": "manager_worker_id",
      "type": "string",
      "required": false
    },
    {
      "source": "active",
      "target": "is_active",
      "type": "boolean",
      "required": true
    },
    {
      "source": "effectiveDate",
      "target": "effective_date",
      "type": "date",
      "required": false
    }
  ],
  "invariants": [
    {
      "id": "identity_complete",
