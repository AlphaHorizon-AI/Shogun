{
  "resource_type": "transformation_profile",
  "manifest_version": "1.0",
  "id": "workday_organization_v1",
  "version": 1,
  "lifecycle": "candidate",
  "title": "Workday organization",
  "description": "Normalize Workday organization records into a versioned Shogun canonical contract.",
  "profile_kind": "canonical_ingress",
  "adapter": "canonical_entity_map_v1",
  "parameters": {},
