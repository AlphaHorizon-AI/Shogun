{
  "resource_type": "transformation_profile",
  "manifest_version": "1.0",
  "id": "hubspot_contact_master_v1",
  "version": 1,
  "lifecycle": "candidate",
  "title": "HubSpot contact master",
  "description": "Normalize HubSpot contact master records into a versioned Shogun canonical contract.",
  "profile_kind": "canonical_ingress",
  "adapter": "canonical_entity_map_v1",
  "parameters": {},
  "platform": {
    "vendor": "HubSpot",
    "product": "CRM",
    "family": "crm"
  },
  "source": {
    "transport": "crm_objects_api",
    "api_version": "CRM v3",
    "object": "contacts",
    "record_shape": "collection",
    "pagination": "paging.next.after",
    "record_path": "results"
  },
  "canonical_contract": {
    "id": "contact_master",
    "version": 1,
    "record_kind": "contact_master"
  },
  "identity": {
    "source_key": [
      "id"
    ],
    "canonical_key": [
      "contact_id"
    ],
    "conflict_policy": "error"
  },
  "field_map": [
    {
      "source": "id",
      "target": "contact_id",
      "type": "string",
      "required": true
    },
    {
      "source": "properties.firstname",
      "target": "first_name",
      "type": "string",
      "required": false
    },
    {
      "source": "properties.lastname",
      "target": "last_name",
      "type": "string",
      "required": true
    },
    {
      "source": "properties.email",
      "target": "email",
      "type": "string",
      "required": false
    },
    {
      "source": "properties.phone",
      "target": "phone",
      "type": "string",
      "required": false
    },
    {
      "source": "properties.jobtitle",
      "target": "job_title",
      "type": "string",
      "required": false
    },
    {
      "source": "properties.company",
      "target": "company_name",
      "type": "string",
      "required": false
    },
    {
      "source": "properties.city",
      "target": "city",
      "type": "string",
      "required": false
    },
    {
      "source": "properties.country",
      "target": "country",
      "type": "string",
      "required": false
    },
    {
      "source": "updatedAt",
      "target": "modified_at",
      "type": "datetime",
      "required": true
    }
  ],
  "invariants": [
    {
      "id": "identity_complete",
      "rule": "required_nonempty",
      "fields": [
        "contact_id"
      ]
    }
  ],
  "privacy": {
    "classification": "confidential",
    "pii_fields": [
      "first_name",
      "last_name",
      "email",
      "phone",
      "job_title",
      "company_name",
      "city"
    ],
    "secret_fields": [],
    "retention": "inherit_flow_policy"
  },
  "adapter_requirements": {
    "adapter": "canonical_entity_map_v1",
    "minimum_version": 1,
    "status": "available",
    "capabilities": [
      "field_mapping",
      "type_conversion",
      "deduplication",
      "canonical_envelope",
      "lineage",
      "invariant_validation",
      "formula_neutralization"
    ],
    "fail_closed": true
  },
  "selection": {
    "positive_fingerprints": [
      "object:contacts",
      "transport:crm_objects_api",
      "field:id"
    ],
    "negative_fingerprints": []
  },
  "governance": {
    "owner": "enterprise_transformation_skill",
    "promotion": "skillopt_validated",
    "minimum_positive_fixtures": 3,
    "minimum_negative_fixtures": 2,
    "breaking_change_policy": "new_profile_version"
  }
}
