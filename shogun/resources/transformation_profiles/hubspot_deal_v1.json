{
  "resource_type": "transformation_profile",
  "manifest_version": "1.0",
  "id": "hubspot_deal_v1",
  "version": 1,
  "lifecycle": "candidate",
  "title": "HubSpot deal",
  "description": "Normalize HubSpot deal records into a versioned Shogun canonical contract.",
  "profile_kind": "canonical_ingress",
  "adapter": "canonical_entity_map_v1",
  "parameters": {},
  "platform": {
    "vendor": "HubSpot",
    "product": "CRM",
    "family": "crm"
  },
  "source": {
    "transport": "crm_objects_api",
    "api_version": "CRM v3",
    "object": "deals",
    "record_shape": "collection",
    "pagination": "paging.next.after",
    "record_path": "results"
  },
  "canonical_contract": {
    "id": "opportunity_pipeline",
    "version": 1,
    "record_kind": "opportunity_pipeline"
  },
  "identity": {
    "source_key": [
      "id"
    ],
    "canonical_key": [
      "opportunity_id"
    ],
    "conflict_policy": "error"
  },
  "field_map": [
    {
      "source": "id",
      "target": "opportunity_id",
      "type": "string",
      "required": true
    },
    {
      "source": "properties.dealname",
      "target": "name",
      "type": "string",
      "required": true
    },
    {
      "source": "properties.dealstage",
      "target": "stage",
      "type": "string",
      "required": true
    },
    {
      "source": "properties.pipeline",
      "target": "pipeline_id",
      "type": "string",
      "required": true
    },
    {
      "source": "properties.amount",
      "target": "amount",
      "type": "decimal",
      "required": false
    },
    {
      "source": "properties.closedate",
      "target": "close_at",
      "type": "datetime",
      "required": false
    },
    {
      "source": "properties.hs_is_closed",
      "target": "is_closed",
      "type": "boolean",
      "required": false
    },
    {
      "source": "properties.hs_is_closed_won",
      "target": "is_won",
      "type": "boolean",
      "required": false
    },
    {
      "source": "properties.hubspot_owner_id",
      "target": "owner_id",
      "type": "string",
      "required": false
    },
    {
      "source": "updatedAt",
      "target": "modified_at",
      "type": "datetime",
      "required": true
    }
  ],
  "invariants": [
    {
      "id": "identity_complete",
      "rule": "required_nonempty",
      "fields": [
        "opportunity_id"
      ]
    }
  ],
  "privacy": {
    "classification": "confidential",
    "pii_fields": [
      "name"
    ],
    "secret_fields": [],
    "retention": "inherit_flow_policy"
  },
  "adapter_requirements": {
    "adapter": "canonical_entity_map_v1",
    "minimum_version": 1,
    "status": "available",
    "capabilities": [
      "field_mapping",
      "type_conversion",
      "deduplication",
      "canonical_envelope",
      "lineage",
      "invariant_validation",
      "formula_neutralization"
    ],
    "fail_closed": true
  },
  "selection": {
    "positive_fingerprints": [
      "object:deals",
      "transport:crm_objects_api",
      "field:id"
    ],
    "negative_fingerprints": []
  },
  "governance": {
    "owner": "enterprise_transformation_skill",
    "promotion": "skillopt_validated",
    "minimum_positive_fixtures": 3,
    "minimum_negative_fixtures": 2,
    "breaking_change_policy": "new_profile_version"
  }
}
