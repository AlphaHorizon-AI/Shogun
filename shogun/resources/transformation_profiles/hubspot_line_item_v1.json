{
  "resource_type": "transformation_profile",
  "manifest_version": "1.0",
  "id": "hubspot_line_item_v1",
  "version": 1,
  "lifecycle": "candidate",
  "title": "HubSpot line item",
  "description": "Normalize HubSpot line item records into a versioned Shogun canonical contract.",
  "profile_kind": "canonical_ingress",
  "adapter": "canonical_entity_map_v1",
  "parameters": {},
  "platform": {
    "vendor": "HubSpot",
    "product": "CRM",
    "family": "crm"
  },
  "source": {
    "transport": "crm_objects_api",
    "api_version": "CRM v3",
    "object": "line_items",
    "record_shape": "collection",
    "pagination": "paging.next.after",
    "record_path": "results"
  },
  "canonical_contract": {
    "id": "sales_line_item",
    "version": 1,
    "record_kind": "sales_line_item"
  },
  "identity": {
    "source_key": [
      "id"
    ],
    "canonical_key": [
      "line_id"
    ],
    "conflict_policy": "error"
  },
  "field_map": [
    {
      "source": "id",
      "target": "line_id",
      "type": "string",
      "required": true
    },
    {
      "source": "properties.hs_product_id",
      "target": "product_id",
      "type": "string",
      "required": false
    },
    {
      "source": "properties.name",
      "target": "description",
      "type": "string",
      "required": true
    },
    {
      "source": "properties.quantity",
      "target": "quantity",
      "type": "decimal",
      "required": true
    },
    {
      "source": "properties.price",
      "target": "unit_price",
      "type": "decimal",
      "required": false
    },
    {
      "source": "properties.amount",
      "target": "line_amount",
      "type": "decimal",
      "required": false
    },
    {
      "source": "properties.discount",
      "target": "discount_amount",
      "type": "decimal",
      "required": false
    },
    {
      "source": "properties.hs_sku",
      "target": "sku",
      "type": "string",
      "required": false
    },
    {
      "source": "updatedAt",
      "target": "modified_at",
      "type": "datetime",
      "required": true
    }
  ],
  "invariants": [
    {
      "id": "identity_complete",
      "rule": "required_nonempty",
      "fields": [
        "line_id"
      ]
    }
  ],
  "privacy": {
    "classification": "confidential",
    "pii_fields": [
      "description"
    ],
    "secret_fields": [],
    "retention": "inherit_flow_policy"
  },
  "adapter_requirements": {
    "adapter": "canonical_entity_map_v1",
    "minimum_version": 1,
    "status": "available",
    "capabilities": [
      "field_mapping",
      "type_conversion",
      "deduplication",
      "canonical_envelope",
      "lineage",
      "invariant_validation",
      "formula_neutralization"
    ],
    "fail_closed": true
  },
  "selection": {
    "positive_fingerprints": [
      "object:line_items",
      "transport:crm_objects_api",
      "field:id"
    ],
    "negative_fingerprints": []
  },
  "governance": {
    "owner": "enterprise_transformation_skill",
    "promotion": "skillopt_validated",
    "minimum_positive_fixtures": 3,
    "minimum_negative_fixtures": 2,
    "breaking_change_policy": "new_profile_version"
  }
}
