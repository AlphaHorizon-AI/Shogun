{
  "resource_type": "transformation_profile",
  "manifest_version": "1.0",
  "id": "d365_fscm_vendor_master_v1",
  "version": 1,
  "lifecycle": "candidate",
  "title": "D365 F&SCM vendor master",
  "description": "Normalize D365 F&SCM vendor master records into a versioned Shogun canonical contract.",
  "profile_kind": "canonical_ingress",
  "adapter": "canonical_entity_map_v1",
  "parameters": {},
  "platform": {
    "vendor": "Microsoft",
    "product": "Dynamics 365 Finance and Supply Chain Management",
    "family": "erp_scm"
  },
  "source": {
    "transport": "odata_v4",
    "api_version": "OData v4; entity schema pinned at activation",
    "object": "VendorsV2",
    "record_shape": "collection",
    "pagination": "@odata.nextLink",
    "company_scope": "dataAreaId",
    "record_path": "value"
  },
  "canonical_contract": {
    "id": "vendor_master",
    "version": 1,
    "record_kind": "vendor_master"
  },
  "identity": {
    "source_key": [
      "dataAreaId",
      "VendorAccountNumber"
    ],
    "canonical_key": [
      "company_code",
      "vendor_id"
    ],
    "conflict_policy": "error"
  },
  "field_map": [
    {
      "source": "dataAreaId",
      "target": "company_code",
      "type": "string",
      "required": true,
      "transforms": [
        "trim",
        "uppercase"
      ]
    },
    {
      "source": "VendorAccountNumber",
      "target": "vendor_id",
      "type": "string",
      "required": true,
      "transforms": [
        "trim"
      ]
    },
    {
      "source": "VendorOrganizationName",
      "target": "name",
      "type": "string",
      "required": true,
      "transforms": [
        "trim"
      ]
    },
    {
      "source": "VendorGroupId",
      "target": "vendor_group_id",
      "type": "string",
      "required": false
    },
    {
      "source": "CurrencyCode",
      "target": "currency_code",
      "type": "string",
      "required": false,
      "transforms": [
        "trim",
        "uppercase"
      ]
    },
    {
      "source": "PaymentTermsName",
      "target": "payment_terms",
      "type": "string",
      "required": false
    },
    {
      "source": "PrimaryContactEmail",
      "target": "email",
      "type": "string",
      "required": false,
      "transforms": [
        "trim",
        "lowercase"
      ]
    },
    {
      "source": "PrimaryContactPhone",
      "target": "phone",
      "type": "string",
      "required": false
    },
    {
      "source": "PrimaryAddressCountryRegionId",
      "target": "country_code",
      "type": "string",
      "required": false,
      "transforms": [
        "trim",
        "uppercase"
      ]
    }
  ],
  "invariants": [
    {
      "id": "identity_complete",
      "rule": "required_nonempty",
      "fields": [
        "company_code",
        "vendor_id"
      ]
    }
  ],
  "privacy": {
    "classification": "confidential",
    "pii_fields": [
      "name",
      "email",
      "phone"
    ],
    "secret_fields": [],
    "retention": "inherit_flow_policy"
  },
  "adapter_requirements": {
    "adapter": "canonical_entity_map_v1",
    "minimum_version": 1,
    "status": "available",
    "capabilities": [
      "field_mapping",
      "type_conversion",
      "deduplication",
      "canonical_envelope",
      "lineage",
      "invariant_validation",
      "formula_neutralization"
    ],
    "fail_closed": true
  },
  "selection": {
    "positive_fingerprints": [
      "object:VendorsV2",
      "transport:odata_v4",
      "field:dataAreaId"
    ],
    "negative_fingerprints": []
  },
  "governance": {
    "owner": "enterprise_transformation_skill",
    "promotion": "skillopt_validated",
    "minimum_positive_fixtures": 3,
    "minimum_negative_fixtures": 2,
    "breaking_change_policy": "new_profile_version"
  }
}
