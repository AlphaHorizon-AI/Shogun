      "dataAreaId",
      "JournalBatchNumber",
      "GeneralJournalAccountEntries.LineNumber"
    ],
    "canonical_key": [
      "company_code",
      "journal_id",
      "line_id"
    ],
    "conflict_policy": "error"
  },
  "field_map": [
    {
      "source": "dataAreaId",
      "target": "company_code",
      "type": "string",
      "required": true
    },
    {
      "source": "JournalBatchNumber",
      "target": "journal_id",
      "type": "string",
      "required": true
    },
    {
      "source": "JournalName",
      "target": "journal_name",
      "type": "string",
      "required": false
    },
    {
      "source": "GeneralJournalAccountEntries.LineNumber",
      "target": "line_id",
      "type": "string",
      "required": true
    },
    {
      "source": "GeneralJournalAccountEntries.TransDate",
      "target": "posting_date",
      "type": "date",
      "required": true
    },
    {
      "source": "GeneralJournalAccountEntries.LedgerAccount",
      "target": "account_id",
      "type": "string",
      "required": true
    },
    {
      "source": "GeneralJournalAccountEntries.CurrencyCode",
      "target": "currency_code",
      "type": "string",
      "required": true,
      "transforms": [
        "trim",
        "uppercase"
      ]
    },
    {
      "source": "GeneralJournalAccountEntries.DebitAmount",
      "target": "debit_amount",
      "type": "decimal",
      "required": true
    },
    {
      "source": "GeneralJournalAccountEntries.CreditAmount",
      "target": "credit_amount",
      "type": "decimal",
      "required": true
    },
    {
      "source": "GeneralJournalAccountEntries.OffsetAccount",
      "target": "offset_account_id",
      "type": "string",
      "required": false
    },
    {
      "source": "GeneralJournalAccountEntries.Description",
      "target": "description",
      "type": "string",
      "required": false
    }
  ],
  "invariants": [
    {
      "id": "identity_complete",
      "rule": "required_non_blank",
      "fields": [
        "company_code",
        "journal_id",
        "line_id"
      ]
    },
    {
      "id": "identity_unique",
      "rule": "unique_composite",
      "fields": [
        "company_code",
        "journal_id",
        "line_id"
      ]
    },
    {
      "id": "required_fields_present",
      "rule": "required_fields_present",
      "fields": [
        "company_code",
        "journal_id",
        "line_id",
        "posting_date",
        "account_id",
        "currency_code",
        "debit_amount",
        "credit_amount"
      ]
    },
    {
      "id": "line_not_both_debit_and_credit",
      "rule": "mutually_exclusive_nonzero",
      "fields": [
        "debit_amount",
        "credit_amount"
      ]
    }
  ],
  "privacy": {
    "classification": "internal",
    "pii_fields": [],
    "secret_fields": [],
    "retention": "inherit_flow_policy"
  },
  "adapter_requirements": {
    "adapter": "canonical_entity_map_v1",
    "minimum_version": 1,
    "status": "planned",
    "capabilities": [
      "field_mapping",
      "type_conversion",
      "deduplication",
      "canonical_envelope",
      "lineage",
      "invariant_validation",
      "formula_neutralization",
      "nested_collection_flattening",
      "business_rule:required_non_blank",
      "business_rule:unique_composite",
      "business_rule:required_fields_present",
      "business_rule:mutually_exclusive_nonzero"
    ],
    "fail_closed": true
