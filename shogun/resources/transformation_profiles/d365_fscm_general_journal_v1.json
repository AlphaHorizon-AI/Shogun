{
  "resource_type": "transformation_profile",
  "manifest_version": "1.0",
  "id": "d365_fscm_general_journal_v1",
  "version": 1,
  "lifecycle": "candidate",
  "title": "D365 F&SCM general journal entries",
  "description": "Normalize D365 F&SCM general journal entries records into a versioned Shogun canonical contract.",
  "profile_kind": "canonical_ingress",
  "adapter": "canonical_entity_map_v1",
  "parameters": {},
  "platform": {
    "vendor": "Microsoft",
    "product": "Dynamics 365 Finance and Supply Chain Management",
    "family": "finance"
  },
  "source": {
    "transport": "odata_v4",
    "api_version": "OData v4; entity schema pinned at activation",
    "object": "GeneralJournalHeaders",
    "record_shape": "header_with_lines",
    "pagination": "@odata.nextLink",
    "related_objects": [
      "GeneralJournalAccountEntries"
    ],
    "company_scope": "dataAreaId",
    "record_path": "value"
