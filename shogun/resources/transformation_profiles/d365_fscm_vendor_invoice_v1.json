{
  "resource_type": "transformation_profile",
  "manifest_version": "1.0",
  "id": "d365_fscm_vendor_invoice_v1",
  "version": 1,
  "lifecycle": "candidate",
  "title": "D365 F&SCM vendor invoice lines",
  "description": "Normalize D365 F&SCM vendor invoice lines records into a versioned Shogun canonical contract.",
  "profile_kind": "canonical_ingress",
  "adapter": "canonical_entity_map_v1",
  "parameters": {},
  "platform": {
    "vendor": "Microsoft",
    "product": "Dynamics 365 Finance and Supply Chain Management",
    "family": "finance"
  },
  "source": {
    "transport": "odata_v4",
    "api_version": "OData v4; entity schema pinned at activation",
    "object": "VendorInvoiceHeaders",
    "record_shape": "header_with_lines",
    "pagination": "@odata.nextLink",
    "related_objects": [
      "VendorInvoiceLines"
    ],
    "company_scope": "dataAreaId",
    "record_path": "value"
  },
  "canonical_contract": {
    "id": "accounts_payable_invoice",
    "version": 1,
    "record_kind": "accounts_payable_invoice"
  },
  "identity": {
    "source_key": [
      "dataAreaId",
      "InvoiceNumber",
      "VendorInvoiceLines.LineNumber"
    ],
    "canonical_key": [
      "company_code",
      "invoice_id",
      "line_id"
    ],
    "conflict_policy": "error"
  },
  "field_map": [
    {
      "source": "dataAreaId",
      "target": "company_code",
      "type": "string",
      "required": true
    },
    {
      "source": "InvoiceNumber",
      "target": "invoice_id",
      "type": "string",
      "required": true
    },
    {
      "source": "VendorAccountNumber",
      "target": "vendor_id",
      "type": "string",
      "required": true
    },
    {
      "source": "InvoiceDate",
      "target": "invoice_date",
      "type": "date",
      "required": true
    },
    {
      "source": "DueDate",
      "target": "due_date",
      "type": "date",
      "required": false
    },
    {
      "source": "CurrencyCode",
      "target": "currency_code",
      "type": "string",
      "required": true,
      "transforms": [
        "trim",
        "uppercase"
      ]
    },
    {
      "source": "InvoiceTotal",
      "target": "invoice_total",
      "type": "decimal",
      "required": false
    },
    {
      "source": "VendorInvoiceLines.LineNumber",
      "target": "line_id",
      "type": "string",
      "required": true
    },
    {
      "source": "VendorInvoiceLines.ItemNumber",
      "target": "product_id",
      "type": "string",
      "required": false
    },
    {
      "source": "VendorInvoiceLines.LineAmount",
      "target": "line_amount",
      "type": "decimal",
      "required": true
    },
    {
      "source": "VendorInvoiceLines.TaxAmount",
      "target": "tax_amount",
      "type": "decimal",
      "required": false
    }
  ],
  "invariants": [
    {
      "id": "identity_complete",
      "rule": "required_non_blank",
      "fields": [
        "company_code",
        "invoice_id",
        "line_id"
      ]
    },
    {
      "id": "identity_unique",
      "rule": "unique_composite",
      "fields": [
        "company_code",
        "invoice_id",
        "line_id"
      ]
    },
    {
      "id": "required_fields_present",
      "rule": "required_fields_present",
      "fields": [
        "company_code",
        "invoice_id",
        "vendor_id",
        "invoice_date",
        "currency_code",
        "line_id",
        "line_amount"
      ]
    },
    {
      "id": "invoice_total_reconciles",
      "rule": "header_equals_line_sum_with_tolerance",
      "fields": [
        "invoice_total",
        "line_amount"
      ],
      "tolerance": "currency_minor_unit"
    }
  ],
  "privacy": {
    "classification": "internal",
    "pii_fields": [],
    "secret_fields": [],
    "retention": "inherit_flow_policy"
  },
  "adapter_requirements": {
    "adapter": "canonical_entity_map_v1",
    "minimum_version": 1,
    "status": "planned",
    "capabilities": [
      "field_mapping",
      "type_conversion",
      "deduplication",
      "canonical_envelope",
      "lineage",
      "invariant_validation",
      "formula_neutralization",
      "nested_collection_flattening",
      "business_rule:required_non_blank",
      "business_rule:unique_composite",
      "business_rule:required_fields_present",
      "business_rule:header_equals_line_sum_with_tolerance"
    ],
    "fail_closed": true
  },
  "selection": {
    "positive_fingerprints": [
      "object:VendorInvoiceHeaders",
      "transport:odata_v4",
      "field:dataAreaId"
    ],
    "negative_fingerprints": []
  },
  "governance": {
    "owner": "enterprise_transformation_skill",
    "promotion": "skillopt_validated",
    "minimum_positive_fixtures": 3,
    "minimum_negative_fixtures": 2,
    "breaking_change_policy": "new_profile_version"
  }
}
