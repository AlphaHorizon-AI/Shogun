{
  "resource_type": "transformation_profile",
  "manifest_version": "1.0",
  "id": "xero_bill_v1",
  "version": 1,
  "lifecycle": "candidate",
  "title": "Xero supplier bill",
  "description": "Normalize Xero supplier bill records into a versioned Shogun canonical contract.",
  "profile_kind": "canonical_ingress",
  "adapter": "canonical_entity_map_v1",
  "parameters": {},
  "platform": {
