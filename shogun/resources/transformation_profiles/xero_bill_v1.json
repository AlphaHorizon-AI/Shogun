      "target": "invoice_type",
      "type": "string",
      "required": true
    },
    {
      "source": "Contact.ContactID",
      "target": "vendor_id",
      "type": "string",
      "required": true
    },
    {
      "source": "Date",
      "target": "invoice_date",
      "type": "date",
      "required": true
    },
    {
      "source": "DueDate",
      "target": "due_date",
      "type": "date",
      "required": false
    },
    {
      "source": "CurrencyCode",
      "target": "currency_code",
      "type": "string",
      "required": true
    },
    {
      "source": "Total",
      "target": "invoice_total",
      "type": "decimal",
      "required": true
    },
    {
      "source": "AmountDue",
      "target": "open_balance",
      "type": "decimal",
      "required": false
    },
    {
      "source": "Status",
      "target": "status",
      "type": "string",
      "required": true
    },
    {
      "source": "UpdatedDateUTC",
      "target": "modified_at",
      "type": "datetime",
      "required": true
    }
  ],
  "invariants": [
