{
  "resource_type": "transformation_profile",
  "manifest_version": "1.0",
  "id": "xero_manual_journal_v1",
  "version": 1,
  "lifecycle": "candidate",
  "title": "Xero manual journal lines",
  "description": "Normalize Xero manual journal lines records into a versioned Shogun canonical contract.",
  "profile_kind": "canonical_ingress",
  "adapter": "canonical_entity_map_v1",
  "parameters": {},
  "platform": {
    "vendor": "Xero",
    "product": "Xero Accounting",
    "family": "accounting"
  },
  "source": {
    "transport": "rest",
    "api_version": "Accounting API 2.0",
    "object": "ManualJournals",
    "record_shape": "header_with_lines",
    "pagination": "page/pageSize",
    "related_objects": [
      "JournalLines"
    ],
    "record_path": "ManualJournals"
  },
  "canonical_contract": {
    "id": "general_journal_entry",
    "version": 1,
    "record_kind": "general_journal_entry"
  },
  "identity": {
