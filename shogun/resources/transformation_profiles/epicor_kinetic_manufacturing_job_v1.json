{
  "resource_type": "transformation_profile",
  "manifest_version": "1.0",
  "id": "epicor_kinetic_manufacturing_job_v1",
  "version": 1,
  "lifecycle": "candidate",
  "title": "Epicor Kinetic manufacturing job",
  "description": "Normalize Epicor Kinetic manufacturing job records into a versioned Shogun canonical contract.",
  "profile_kind": "canonical_ingress",
  "adapter": "canonical_entity_map_v1",
  "parameters": {},
  "platform": {
    "vendor": "Epicor",
    "product": "Kinetic",
    "family": "manufacturing"
  },
  "source": {
    "transport": "rest",
    "api_version": "REST v2; service schema pinned at activation",
    "object": "Erp.BO.JobEntrySvc/JobHeads",
    "record_shape": "collection",
    "pagination": "server paging",
    "company_scope": "Company",
    "record_path": "value"
  },
  "canonical_contract": {
    "id": "production_order",
    "version": 1,
    "record_kind": "production_order"
  },
  "identity": {
    "source_key": [
      "Company",
      "JobNum"
    ],
    "canonical_key": [
      "company_code",
      "production_order_id"
    ],
    "conflict_policy": "error"
  },
  "field_map": [
    {
      "source": "Company",
      "target": "company_code",
      "type": "string",
      "required": true
    },
    {
      "source": "JobNum",
      "target": "production_order_id",
      "type": "string",
      "required": true
    },
    {
      "source": "PartNum",
      "target": "product_id",
      "type": "string",
      "required": true
    },
    {
      "source": "JobEngineered",
      "target": "is_engineered",
      "type": "boolean",
      "required": false
    },
    {
      "source": "JobReleased",
      "target": "is_released",
      "type": "boolean",
      "required": false
    },
    {
      "source": "JobComplete",
      "target": "is_complete",
      "type": "boolean",
      "required": false
    },
    {
      "source": "ProdQty",
      "target": "ordered_quantity",
      "type": "decimal",
      "required": true
    },
    {
      "source": "QtyCompleted",
      "target": "completed_quantity",
      "type": "decimal",
      "required": false
    },
    {
      "source": "StartDate",
      "target": "scheduled_start_date",
      "type": "date",
      "required": false
    },
    {
      "source": "DueDate",
      "target": "scheduled_end_date",
      "type": "date",
      "required": false
    },
    {
      "source": "Plant",
      "target": "site_id",
      "type": "string",
      "required": true
    }
  ],
  "invariants": [
    {
      "id": "identity_complete",
      "rule": "required_nonempty",
      "fields": [
        "company_code",
        "production_order_id"
      ]
    }
  ],
  "privacy": {
    "classification": "internal",
    "pii_fields": [],
    "secret_fields": [],
    "retention": "inherit_flow_policy"
  },
  "adapter_requirements": {
    "adapter": "canonical_entity_map_v1",
    "minimum_version": 1,
    "status": "available",
    "capabilities": [
      "field_mapping",
      "type_conversion",
      "deduplication",
      "canonical_envelope",
      "lineage",
      "invariant_validation",
      "formula_neutralization"
    ],
    "fail_closed": true
  },
  "selection": {
    "positive_fingerprints": [
      "object:Erp.BO.JobEntrySvc/JobHeads",
      "transport:rest",
      "field:Company"
    ],
    "negative_fingerprints": []
  },
  "governance": {
    "owner": "enterprise_transformation_skill",
    "promotion": "skillopt_validated",
    "minimum_positive_fixtures": 3,
    "minimum_negative_fixtures": 2,
    "breaking_change_policy": "new_profile_version"
  }
}
