# Force Windows batch files to always use CRLF line endings,
# including in GitHub ZIP downloads (archive exports).
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts always LF
*.sh  text eol=lf
*.command text eol=lf
.githooks/* text eol=lf

# Public incident fixture digests are calculated over the downloaded PEM bytes.
tests/fixtures/emudhra/*.crt text eol=lf

# Keep generated frontend entry points consistent across release builders.
frontend/*.html text eol=lf
frontend/dist/*.html text eol=lf
