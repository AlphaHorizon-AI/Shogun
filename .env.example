# Shogun AgentFlow — Minimal Environment Configuration
APP_ENV=production
DEPLOYMENT_MODE=desktop
API_HOST=127.0.0.1
API_PORT=8000

# SQLite database (default: ./data/shogun.db)
DATABASE_URL=sqlite+aiosqlite:///./data/shogun.db

# Generated automatically on first run if left unset
SECRET_KEY=change-me-to-a-random-64-char-string
VAULT_ENCRYPTION_KEY=change-me-to-a-fernet-base64-key
SHOGUN_INFRASTRUCTURE_ADMIN_TOKEN=
