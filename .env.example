# ── Shogun Environment Configuration ─────────────────────────
# Copy this to .env and adjust as needed.

# Application
APP_ENV=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
# Uncomment below for development (enables SQL echo logging):
# APP_ENV=development
# DEBUG=true

# Database — SQLite (default, zero-install)
DATABASE_URL=sqlite+aiosqlite:///./data/shogun.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://shogun:shogun_dev_password@localhost:5432/shogun

# Qdrant — Embedded mode (default, no Docker needed)
# Leave QDRANT_URL empty for embedded mode with local storage
# QDRANT_URL=http://localhost:6333
QDRANT_PATH=./data/qdrant

# Security
SECRET_KEY=change-me-to-a-random-64-char-string
VAULT_ENCRYPTION_KEY=change-me-to-a-fernet-base64-key
SHOGUN_INFRASTRUCTURE_ADMIN_TOKEN=

# Optional installation telemetry. Off means no connection is made.
# Enabling requires both values and explicit acceptance of notice 1.0.
SHOGUN_TELEMETRY=off
SHOGUN_TELEMETRY_NOTICE_VERSION=
SHOGUN_DISTRIBUTION_CHANNEL=official_installer
SHOGUN_BUILD_ID=144

# Outbound A2A/Gensui destination policy
A2A_DESTINATION_POLICY=private_allowed
GENSUI_DESTINATION_POLICY=loopback_allowed
OUTBOUND_ALLOWLIST=
ALLOW_HTTP_ON_PRIVATE_NETWORK=true
ALLOW_HTTP_ON_PUBLIC_NETWORK=false
A2A_ALLOWED_PORTS=
GENSUI_ALLOWED_PORTS=

# Storage
VAULT_PATH=./vault
LOG_PATH=./logs
CONFIG_PATH=./configs

# Telegram (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS=

# Microsoft Teams adapter (store secret values in a vault; configure references here)
TEAMS_ADAPTER_ENABLED=false
TEAMS_DEPLOYMENT_MODE=dev
TEAMS_TENANT_MODE=single
TEAMS_ALLOWED_TENANT_IDS=
TEAMS_BOT_APP_ID=
TEAMS_BOT_CLIENT_SECRET_REF=
TEAMS_PUBLIC_MESSAGING_ENDPOINT=
TEAMS_SSO_ENABLED=false
TEAMS_GRAPH_ENABLED=false
TEAMS_PROACTIVE_ENABLED=false
TEAMS_MANIFEST_VALID_DOMAINS=
TEAMS_RATE_LIMIT_PER_USER_PER_MINUTE=20
TEAMS_RATE_LIMIT_PER_CHANNEL_PER_MINUTE=60
TEAMS_HIGH_RISK_CONFIRMATION_TTL_SECONDS=300
TEAMS_BRIDGE_URL=http://127.0.0.1:3978
SHOGUN_INTERNAL_API_URL=http://127.0.0.1:8000
SHOGUN_INTERNAL_API_KEY_REF=
# SHOGUN_INTERNAL_API_KEY is injected by the runtime/secret store, not committed to .env.

# Flow Stacking (hierarchical AgentFlow execution)
FLOW_STACKING_ENABLED=true
FLOW_STACKING_MAX_DEPTH=3
FLOW_STACKING_HARD_MAX_DEPTH=5
FLOW_STACKING_MAX_CHILD_RUNS_PER_PARENT=20
FLOW_STACKING_MAX_TOTAL_RUNS_PER_ROOT=100
FLOW_STACKING_DEFAULT_TIMEOUT_SECONDS=600
FLOW_STACKING_ALLOW_LATEST_VERSION=true
FLOW_STACKING_MAX_PARALLEL_CHILDREN=4
STACK_ORCHESTRATOR_ENABLED=true
STACK_ORCHESTRATOR_ALLOW_SUPERVISED=true
STACK_ORCHESTRATOR_DEFAULT_RUNTIME_MINUTES=60
STACK_ORCHESTRATOR_POLL_INTERVAL_SECONDS=0.25
STACK_ORCHESTRATOR_MAX_STEPS=100
