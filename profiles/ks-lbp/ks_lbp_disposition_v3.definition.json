{
  "id": "ks_lbp_disposition_v3",
  "version": 3,
  "adapter": "sectioned_record_matrix_v1",
  "parameters": {
    "required_source_patterns": [
      "(?m)^\\s*Sachnummer\\s*:\\s*\\S+",
      "(?m)^\\s*Teilebez\\.\\s*:",
      "(?m)^\\s*Sa\\s+Artikelnummer\\b"
    ],
    "section_pattern": "(?m)^\\s*Sachnummer\\s*:\\s*(?P<section_id>\\S+)",
    "section_key_group": "section_id",
    "section_fields": [
      {
        "target": "description",
        "pattern": "(?m)^\\s*Teilebez\\.\\s*:\\s*(?P<value>.*?)\\s+Werkstoff\\s*:",
        "group": "value",
        "aggregate": "first"
      },
      {
        "target": "stock",
        "pattern": "(?m)^\\s*Bestand\\s*:\\s*(?P<value>[+-]?(?:\\d{1,3}(?:[ .\\u00a0\\u202f]\\d{3})+|\\d+)(?:,\\d+)?)",
        "group": "value",
        "value_type": "localized_number",
        "aggregate": "max"
      }
    ],
    "selector_fields": [
      {
        "target": "rohling",
        "scope_pattern": "(?ims)^\\s*St\\S*ckliste\\s*:.*?\\n(?P<body>.*?)^\\s*Bemerkungen\\s*:",
        "line_pattern": "(?m)^\\s*\\d{4}\\s+(?P<value>\\S+)\\s+(?P<text>.+?)\\s+[\\d.,-]+\\s+\\S+\\s*$",
        "include_terms": ["rohling"],
        "exclude_terms": [
          "beutel",
          "box",
          "duese",
          "düse",
          "faltkiste",
          "kiste",
          "pack",
          "spannstift",
          "teleskop",
          "verpack"
        ],
        "aggregate": "first"
      },
      {
        "target": "rohteil",
        "when": {
          "not": {
            "field": "description",
            "operator": "matches",
            "pattern": "^\\s*Kolben\\s+geb\\."
          }
        },
        "scope_pattern": "(?ims)^\\s*St\\S*ckliste\\s*:.*?\\n(?P<body>.*?)^\\s*Bemerkungen\\s*:",
        "line_pattern": "(?m)^\\s*\\d{4}\\s+(?P<value>\\S+)\\s+(?P<text>.+?)\\s+[\\d.,-]+\\s+\\S+\\s*$",
        "include_terms": ["rohteil", "halbzeug", "vorbearb", "kolben"],
        "exclude_terms": [
          "rohling",
          "beutel",
          "box",
          "duese",
          "düse",
          "faltkiste",
          "kiste",
          "pack",
          "spannstift",
          "teleskop",
          "verpack"
        ],
        "aggregate": "first"
      },
      {
        "target": "unterteil",
        "when": {
          "field": "description",
          "operator": "matches",
          "pattern": "^\\s*Kolben\\s+geb\\."
        },
        "scope_pattern": "(?ims)^\\s*St\\S*ckliste\\s*:.*?\\n(?P<body>.*?)^\\s*Bemerkungen\\s*:",
        "line_pattern": "(?m)^\\s*\\d{4}\\s+(?P<value>\\S+)\\s+(?P<text>.+?)\\s+[\\d.,-]+\\s+\\S+\\s*$",
        "include_terms": ["kolben-ut"],
        "minimum_matches": 1,
        "maximum_matches": 1,
        "distinct": true,
        "aggregate": "first"
      },
      {
        "target": "oberteil",
        "when": {
          "field": "description",
          "operator": "matches",
          "pattern": "^\\s*Kolben\\s+geb\\."
        },
        "scope_pattern": "(?ims)^\\s*St\\S*ckliste\\s*:.*?\\n(?P<body>.*?)^\\s*Bemerkungen\\s*:",
        "line_pattern": "(?m)^\\s*\\d{4}\\s+(?P<value>\\S+)\\s+(?P<text>.+?)\\s+[\\d.,-]+\\s+\\S+\\s*$",
        "include_terms": ["kolben-ot"],
        "minimum_matches": 1,
        "maximum_matches": 1,
        "distinct": true,
        "aggregate": "first"
      }
    ],
    "record_pattern": "(?m)^\\s*(?P<kind>01|06)\\s+(?P<article>\\S+)\\s+(?P<reference>\\S+)\\s+(?P<period_1_week>\\d{4}/\\d{2})\\s+(?P<period_1_month>\\d{4}/\\d{2})\\s+(?P<period_2_week>\\d{4}/\\d{2})\\s+(?P<period_2_month>\\d{4}/\\d{2})\\s+(?P<planned>[+-]?(?:\\d{1,3}(?:[ .\\u00a0\\u202f]\\d{3})+|\\d+)(?:,\\d+)?)\\s+(?P<remaining>[+-]?(?:\\d{1,3}(?:[ .\\u00a0\\u202f]\\d{3})+|\\d+)(?:,\\d+)?)\\s+(?P<date>\\d{2}\\.\\d{2}\\.\\d{4})\\s*$",
    "record_section_key_group": "article",
    "record_header_layout": {
      "pattern": "(?im)^\\s*(?P<period_1_role>Endtermin|Starttermin)\\s+(?P<period_2_role>Endtermin|Starttermin)\\s*$",
      "required": true,
      "slots": {
        "period_1_role": {"week": "period_1_week", "month": "period_1_month"},
        "period_2_role": {"week": "period_2_week", "month": "period_2_month"}
      },
      "roles": {
        "start": {
          "aliases": ["Starttermin"],
          "targets": {"week": "start_week", "month": "start_month"}
        },
        "end": {
          "aliases": ["Endtermin"],
          "targets": {"week": "end_week", "month": "end_month"}
        }
      }
    },
    "template": {
      "minimum_columns": 10,
      "expected_headers": {
        "1": ["Artikel-Nr", "Artikelnummer"],
        "4": ["Fertigungsauftrag"]
      },
      "planning_start_column": 10,
      "backlog_headers": ["Rückstand", "RÃ¼ckstand", "Ruckstand", "Rueckstand"],
      "future_header_patterns": [
        "(?:>=|≥|\\bab\\b|\\bfrom\\b|future|sp[äa]ter)",
        "\\+\\s*$"
      ]
    },
    "base_columns": {
      "0": {"field": "description"},
      "1": {"section_key": true},
      "2": {
        "coalesce": [
          {
            "join": {
              "values": [
                {"field": "unterteil"},
                {"field": "oberteil"}
              ],
              "separator": " // ",
              "require_all": true
            }
          },
          {"field": "rohling"}
        ]
      },
      "3": {"field": "rohteil"}
    },
    "section_order": {
      "target_field": "material_group",
      "groups": [
        {
          "name": "Gebaute Kolben",
          "when": {
            "field": "description",
            "operator": "matches",
            "pattern": "^\\s*Kolben\\s+geb\\."
          }
        },
        {
          "name": "S-Kolben",
          "when": {
            "field": "description",
            "operator": "matches",
            "pattern": "^\\s*(?:Kolben\\s+)?S\\s"
          }
        },
        {
          "name": "Einteilige GGG-Kolben",
          "when": {
            "field": "description",
            "operator": "matches",
            "pattern": "^\\s*Kolben\\s+G\\s"
          }
        },
        {
          "name": "IAM Kolben",
          "when": {
            "field": "description",
            "operator": "matches",
            "pattern": "^\\s*ESG-Kolben\\b"
          }
        },
        {
          "name": "Lose Kolbenkomponenten",
          "when": {
            "field": "description",
            "operator": "matches",
            "pattern": "^\\s*(?:Kolben-(?:UT|OT|Hemd)\\b|Kolben\\s+STU\\b|Rohling\\b)"
          }
        },
        {
          "name": "Weitere KS-LBP-Teile",
          "when": {
            "field": "description",
            "operator": "matches",
            "pattern": "^\\s*(?:Motorteil|Dehnschraube|Kolbenbolzen|Zylinderlaufbuchse|Gleitschuh|Stehbolzen\\s+Set|Einbauteile\\s+KIT)\\b"
          }
        }
      ],
      "unmatched": "error",
      "dependencies_before": {
        "fields": ["unterteil", "oberteil"],
        "missing": "ignore"
      }
    },
    "row_rules": [
      {
        "kind": "section",
        "when": {"field": "stock", "operator": "positive"},
        "columns": {
          "4": {"literal": "Lager 0031"},
          "5": {"field": "stock"}
        }
      },
      {
        "kind": "record",
        "match": {"kind": "06"},
        "deduplicate_by": [
          {"group": "article"},
          {"group": "reference", "transforms": ["strip_leading_zero"]}
        ],
        "columns": {
          "4": {"group": "reference", "transforms": ["strip_leading_zero"]},
          "5": {"group": "planned", "value_type": "localized_number"}
        }
      },
      {
        "kind": "record",
        "when": {
          "field": "description",
          "operator": "matches",
          "pattern": "^\\s*Kolben\\s+geb\\."
        },
        "match": {"kind": "01"},
        "planning": {
          "key_group": "start_month",
          "value_group": "planned",
          "value_type": "localized_number",
          "destination": "planning_month",
          "strict_accounting": true
        }
      },
      {
        "kind": "aggregate",
        "when": {
          "not": {
            "field": "description",
            "operator": "matches",
            "pattern": "^\\s*Kolben\\s+geb\\."
          }
        },
        "match": {"kind": "01"},
        "key_group": "start_month",
        "value_group": "remaining",
        "value_type": "localized_number",
        "destination": "planning_month",
        "strict_accounting": true
      }
    ]
  },
  "model_fallback": false
}
