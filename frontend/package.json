{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.mjs",
    "analyze": "vite build --mode analyze",
    "lint": "eslint .",
    "lint:security": "eslint src/lib/infrastructureAuth.ts src/lib/infrastructureAuth.test.ts src/lib/safeMarkdown.ts src/lib/safeMarkdown.test.ts",
    "test:i18n": "node scripts/check-setup-i18n.mjs",
    "test:template-i18n": "node scripts/check-template-i18n.mjs",
    "test:security": "vitest run src/lib/infrastructureAuth.test.ts src/lib/safeMarkdown.test.ts src/lib/safeObjectPath.test.ts",
    "audit:security": "node ../scripts/check-npm-audit.mjs .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "@xyflow/react": "^12.11.5",
    "axios": "1.20.0",
    "clsx": "^2.1.1",
    "js-yaml": "^4.3.1",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "17.11.0",
    "postcss": "8.5.26",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
