# ── Gensui Server Configuration ──────────────────────────────
# Copy this file to .env and customize for your deployment.

# Server
GENSUI_SERVER_HOST=127.0.0.1
GENSUI_SERVER_PORT=8787
DEBUG=false
GENSUI_FRONTEND_DIST=./frontend/dist

# Database (SQLite default, change for PostgreSQL)
GENSUI_DATABASE_URL=sqlite+aiosqlite:///./data/gensui.db

# Security — CHANGE THESE IN PRODUCTION
GENSUI_JWT_SECRET_FILE=./data/secrets/jwt_secret
GENSUI_ACCESS_TOKEN_MINUTES=15
GENSUI_REFRESH_TOKEN_DAYS=7
GENSUI_COOKIE_SECURE=false
GENSUI_TRUSTED_PROXIES=

# Initial Admin Account — CHANGE PASSWORD AFTER FIRST LOGIN
GENSUI_ADMIN_EMAIL=admin@gensui.local
GENSUI_ADMIN_PASSWORD=change-me-to-a-random-admin-password
# Local demonstrations only. Requires GENSUI_SERVER_HOST to be a loopback address.
GENSUI_ALLOW_INSECURE_LOCAL_PASSWORD=false

# Enrollment
GENSUI_REQUIRE_ENROLLMENT_APPROVAL=true
GENSUI_DEFAULT_POSTURE=STANDARD

# Telemetry
GENSUI_TELEMETRY_DEFAULT_MODE=STANDARD

# Harakiri Controls
GENSUI_ENABLE_GLOBAL_HARAKIRI=true
GENSUI_ENABLE_GROUP_HARAKIRI=true
GENSUI_ENABLE_INDIVIDUAL_HARAKIRI=true

# Heartbeat
GENSUI_HEARTBEAT_TIMEOUT_SECONDS=60
